# Identificador público do cliente OAuth já criado no Google Cloud.
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Gere um segredo diferente para cada ambiente. Nunca envie este arquivo ao Git.
SESSION_SECRET=""
ALLOWED_EMAIL_DOMAIN="mota.adv.br"
# E-mails autorizados a publicar conteúdo, administrar o CRM e assumir chamados.
ADMIN_EMAILS="ti@mota.adv.br"
PORT="3002"
NODE_ENV="development"

# Somente para revisar o layout no próprio computador. Nunca use em produção.
VITE_LOCAL_PREVIEW="false"
LOCAL_PREVIEW="false"
LOCAL_PREVIEW_EMAIL="ti@mota.adv.br"

# Diretório persistente da Central de TI. Em Docker, é atendido por volume nomeado.
DATA_DIR="data"

# Defina o host público apenas na configuração de publicação.
INTRANET_HOST="intranet.motaadv.net"
TRAEFIK_NETWORK="traefik"
TRAEFIK_CERTRESOLVER=""
